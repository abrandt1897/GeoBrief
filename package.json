{
  "name": "geobrief",
  "private": true,
  "type": "module",
  "description": "Lint, format and type-check tooling for the GeoBrief dashboard.",
  "scripts": {
    "build": "python3 dashboard/build.py",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md && npm run lint:html && npm run typecheck && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"dashboard/**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "lint:html": "npm run build && html-validate dashboard/dist/index.html",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "python3 -m pytest && npm run test:e2e",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  }
}
